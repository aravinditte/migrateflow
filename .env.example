# Copy to .env for docker compose. Development defaults only - change for any shared environment.
POSTGRES_DB=migrateflow
POSTGRES_USER=migrateflow
POSTGRES_PASSWORD=migrateflow-dev-pw

# Public showcase bootstrap (Automated Showcase spec section 4).
# Leave disabled for normal use. To create the public demo scenario on a
# fresh database, set ENABLED=true and a TOKEN, start the stack, then run:
#   docker compose --profile showcase up showcase-bootstrap
# Public deployments must NOT reuse the *-dev-pw demo passwords below.
MIGRATEFLOW_SHOWCASE_BOOTSTRAP_ENABLED=false
MIGRATEFLOW_SHOWCASE_BOOTSTRAP_TOKEN=
MIGRATEFLOW_SHOWCASE_SLUG=hinata-trading

# Demo seed users (created only when the users table is empty)
MIGRATEFLOW_DEMO_SEED_ENABLED=true
MIGRATEFLOW_ENGINEER_PASSWORD=engineer-dev-pw
MIGRATEFLOW_REVIEWER_PASSWORD=reviewer-dev-pw
MIGRATEFLOW_AUDITOR_PASSWORD=auditor-dev-pw
MIGRATEFLOW_ADMIN_PASSWORD=admin-dev-pw
